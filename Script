end

local function startSession(tier)
	login(tier)
	playIntro()
	setMenuVisible(true)
	task.delay(0.45, function() selectTab(playerTab) end)
	task.delay(1.2, function() toast("installerScripts v" .. VERSION .. " - доступ: " .. tier, "ok") end)
end

local savedTier = matchKey(loadKey())
if savedTier then
	startSession(savedTier)
else
	local tier = showKeyGate()
	if tier then startSession(tier) end
end