-- Открытие / закрытие меню (влетает в жемчужину и вылетает из неё)
----------------------------------------------------------------
local menuVisible = false
local menuPos = UDim2.fromScale(0.5, 0.5)

local function setMenuVisible(v)
	menuVisible = v
	Pearl.menuOpen = v
	Pearl.burst()
	if v then
		if not root.Visible then
			root.Position = Pearl.center()
			uiScale.Scale = 0.05
			window.GroupTransparency = 1
			rootStroke.Transparency = 1
			root.Visible = true
		end
		tween(root, 0.7, { Position = menuPos }, Enum.EasingStyle.Quint)
		tween(uiScale, 0.7, { Scale = currentScale() }, Enum.EasingStyle.Back)
		tween(window, 0.45, { GroupTransparency = 0 })
		tween(rootStroke, 0.45, { Transparency = 0 })
		task.delay(0.4, function()
			if menuVisible and currentTab then popRows(currentTab) end
		end)
	else
		tween(root, 0.5, { Position = Pearl.center() }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tween(uiScale, 0.5, { Scale = 0.05 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tween(window, 0.4, { GroupTransparency = 1 })
		tween(rootStroke, 0.4, { Transparency = 1 })
		task.delay(0.55, function()
			if not menuVisible then root.Visible = false end
		end)
	end
end

-- Применить размер меню (из настроек)
local function applyMenuSize()
	local size = UDim2.fromOffset(Menu.w, Menu.h)
	if root.Visible and menuVisible then
		tween(root, 0.3, { Size = size })
		tween(uiScale, 0.3, { Scale = currentScale() })
	else
		root.Size = size
	end
end

do
	local cam0 = workspace.CurrentCamera
