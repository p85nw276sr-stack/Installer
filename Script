-- Конструктор вкладок и элементов
----------------------------------------------------------------
-- Волна от нажатия (внутри строки)
local function ripple(layer, x)
	local w = layer.AbsoluteSize.X
	if w <= 0 then return end
	local a = math.clamp((x - layer.AbsolutePosition.X) / w, 0, 1)
	local r = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(a, 0.5),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Size = UDim2.fromScale(0, 0),
		BackgroundColor3 = THEME.accent2,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
	}, layer)
	roundCorner(r)
	tween(r, 0.7, { Size = UDim2.fromScale(5, 5), BackgroundTransparency = 1 }).Completed:Connect(function()
		r:Destroy()
	end)
end

local function createTab(name, hidden)
	local tab = { name = name, hidden = hidden, rowScales = {} }
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end

	if not hidden then
		tab.y = #tabs * 36
		tab.btn = new("TextButton", {
			Position = UDim2.new(0, 8, 0, tab.y),
			Size = UDim2.new(1, -16, 0, 32),
			BackgroundTransparency = 1,
			Text = name,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = THEME.sub,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			AutoButtonColor = false,
		}, tabHolder)
		tab.pad = new("UIPadding", { PaddingLeft = UDim.new(0, 16) }, tab.btn)
	end

	tab.page = new("CanvasGroup", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
	}, content)
	local scroll = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = "@accent",
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, tab.page)
	tab.scroll = scroll
	new("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 16),
		PaddingRight = UDim.new(0, 16),
		PaddingBottom = UDim.new(0, 14),
	}, scroll)

	if not hidden then
		connect(tab.btn.MouseEnter, function()
			if currentTab ~= tab then
				tween(tab.btn, 0.15, { TextColor3 = THEME.text })
				tween(tab.pad, 0.2, { PaddingLeft = UDim.new(0, 20) })
			end
		end)
		connect(tab.btn.MouseLeave, function()
			if currentTab ~= tab then
				tween(tab.btn, 0.15, { TextColor3 = THEME.sub })
				tween(tab.pad, 0.2, { PaddingLeft = UDim.new(0, 16) })
			end
		end)
		connect(tab.btn.MouseButton1Click, function()
			if searching then
				searching = false
				restoreRows()
				searchBox.Text = ""
			end
			selectTab(tab)
		end)
	end

	-- во время перетаскивания ползунка отключаем прокрутку и в обычной вкладке, и в поиске
	local function setScrolling(v)
		scroll.ScrollingEnabled = v
		if searchTab and searchTab.scroll then searchTab.scroll.ScrollingEnabled = v end
	end

	-- Gate(tiers): все строки, созданные после этого вызова, доступны только этим уровням ключа.
	-- Gate(nil) снимает ограничение. Недоступные строки закрываются замком.
	function tab.Gate(tiers)
		tab.gate = tiers
	end

	-- Удалить все строки (для динамических страниц, например страницы игры)
	function tab.Clear()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		order = 0
		tab.rowScales = {}
		tab.gate = nil
		scroll.CanvasPosition = Vector2.zero
	end

	local function baseRow(height)
		local row = new("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = "@element",
			BackgroundTransparency = 0.12,
			LayoutOrder = nextOrder(),
		}, scroll)
		corner(row, 8)
		stroke(row, "@stroke", 1, 0.4)
		-- слой для волны: создаётся первым, значит рисуется под текстом
		local layer = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
		}, row)
		local sc = new("UIScale", {}, row)
		table.insert(tab.rowScales, sc)

		-- замок для строк, которые доступны не всем уровням ключа
		local entry = {}
		local gate = tab.gate
		if gate then
			entry.tiers = gate
			local lock = new("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = "@bg",
				BackgroundTransparency = 0.2,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 50,
				Visible = not allowed(gate),
			}, row)
			corner(lock, 8)
			new("TextLabel", {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -16, 1, 0),
				BackgroundTransparency = 1,
				Text = "🔒  " .. tierText(gate),
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = "@accent2",
				TextWrapped = true,
				ZIndex = 51,
			}, lock)
			entry.lock = lock
			table.insert(lockables, entry)
		end
		return row, layer, entry
	end

	-- запись строки в индекс поиска
	local function register(row, a, b, c)
		if tab.noSearch then return end
		table.insert(allRows, {
			row = row,
			home = scroll,
			order = row.LayoutOrder,
			text = string.lower(name .. " " .. (a or "") .. " " .. (b or "") .. " " .. (c or "")),
		})
	end

	local function rowLabel(row, text, y, w)
		return new("TextLabel", {
			Position = UDim2.new(0, 14, 0, y),
			Size = UDim2.new(w or 1, -(w and 0 or 90), 0, 20),
			BackgroundTransparency = 1,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextColor3 = "@text",
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
	end

	local function rowValue(row, y)
		return new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, y),
			Size = UDim2.fromOffset(90, 20),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = "@accent2",
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)
	end

	local function hover(row, hit)
		connect(hit.MouseEnter, function()
			tween(row, 0.2, { BackgroundColor3 = THEME.elementHover })
		end)
		connect(hit.MouseLeave, function()
			tween(row, 0.25, { BackgroundColor3 = THEME.element })
		end)
	end

	-- Произвольная строка (для карточек игр и т.п). plain = true - без фона и рамки.
	function tab.Raw(height, a, b, c, plain)
		local row = new("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = "@element",
			BackgroundTransparency = plain and 1 or 0.12,
			LayoutOrder = nextOrder(),
		}, scroll)
		if not plain then
			corner(row, 10)
			stroke(row, "@stroke", 1, 0.4)
		end
		register(row, a, b, c)
		return row
	end

	-- Заголовок секции
	function tab.Section(text)
		local f = new("Frame", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
		}, scroll)
		new("TextLabel", {
			Position = UDim2.fromOffset(2, 2),
			Size = UDim2.new(1, 0, 0, 16),
			BackgroundTransparency = 1,
			Text = string.upper(text),
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			TextColor3 = "@accent2",
			TextXAlignment = Enum.TextXAlignment.Left,
		}, f)
		local line = new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, f)
		local g = accentGradient(line, 0)
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end

	-- Переключатель
	function tab.Toggle(text, desc, default, callback, keywords)
		local row, layer, entry = baseRow(desc and 56 or 44)
		new("TextLabel", {
			Position = UDim2.new(0, 14, 0, desc and 9 or 0),
			Size = UDim2.new(1, -80, 0, desc and 20 or 44),
			BackgroundTransparency = 1,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextColor3 = "@text",
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
		if desc then
			new("TextLabel", {
				Position = UDim2.new(0, 14, 0, 29),
				Size = UDim2.new(1, -80, 0, 16),
				BackgroundTransparency = 1,
				Text = desc,
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = "@sub",
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)
		end

		local hit = new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 3,
		}, row)
		local switch = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(40, 22),
			BackgroundColor3 = THEME.off,
		}, row)
		roundCorner(switch)
		local glow = stroke(switch, "@accent2", 1.5, 1)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, switch)
		roundCorner(knob)

		local state = false
		local function set(v, silent)
			state = v
			tween(switch, 0.3, { BackgroundColor3 = v and THEME.accent or THEME.off })
			tween(glow, 0.3, { Transparency = v and 0.35 or 1 })
			tween(knob, 0.35, {
				Position = v and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			}, Enum.EasingStyle.Back)
			if not silent then task.spawn(callback, v) end
		end
		table.insert(refreshers, function()
			tween(switch, 0.4, { BackgroundColor3 = state and THEME.accent or THEME.off })
		end)
		-- если уровень ключа поменялся и функция закрылась замком - выключаем её
		entry.reset = function()
			if state then set(false) end
		end

		connect(hit.InputBegan, function(input)
			if isPress(input) then ripple(layer, input.Position.X) end
		end)
		connect(hit.MouseButton1Click, function() set(not state) end)
		hover(row, hit)
		if default then set(true, true) end
		register(row, text, desc, keywords)
		return { Set = set }
	end

	-- Ползунок (fmt - необязательная функция форматирования значения)
	function tab.Slider(text, min, max, default, callback, fmt, keywords)
		local row = baseRow(58)
		rowLabel(row, text, 8, 1)
		local valueLabel = rowValue(row, 8)
		local valueScale = new("UIScale", {}, valueLabel)
		local track = new("Frame", {
			Position = UDim2.new(0, 14, 0, 40),
			Size = UDim2.new(1, -28, 0, 6),
			BackgroundColor3 = "@off",
		}, row)
		roundCorner(track)
		local fill = new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, track)
		roundCorner(fill)
		accentGradient(fill, 0)
		local knob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 3,
		}, track)
		roundCorner(knob)
		local knobGlow = stroke(knob, "@accent2", 3, 1)
		local hit = new("TextButton", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 4,
		}, track)

		local value = default
		local function render(v, animate)
			local a = (v - min) / (max - min)
			valueLabel.Text = fmt and fmt(v) or tostring(v)
			if animate then
				tween(fill, 0.1, { Size = UDim2.fromScale(a, 1) }, Enum.EasingStyle.Quad)
				tween(knob, 0.1, { Position = UDim2.fromScale(a, 0.5) }, Enum.EasingStyle.Quad)
			else
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.fromScale(a, 0.5)
			end
		end
		local function setValue(v)
			if v ~= value then
				value = v
				render(v, true)
				valueScale.Scale = 1.2
				tween(valueScale, 0.2, { Scale = 1 })
				task.spawn(callback, v)
			end
		end
		local function setFromX(x)
			local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setValue(math.floor(min + (max - min) * a + 0.5))
		end

		local dragging = false
		connect(hit.InputBegan, function(input)
			if isPress(input) then
				dragging = true
				setScrolling(false)
				tween(knob, 0.2, { Size = UDim2.fromOffset(19, 19) }, Enum.EasingStyle.Back)
				tween(knobGlow, 0.2, { Transparency = 0.5 })
				setFromX(input.Position.X)
			end
		end)
		connect(UIS.InputChanged, function(input)
			if dragging and isMove(input) then setFromX(input.Position.X) end
		end)
		connect(UIS.InputEnded, function(input)
			if dragging and isPress(input) then
				dragging = false
				setScrolling(true)
				tween(knob, 0.25, { Size = UDim2.fromOffset(14, 14) })
				tween(knobGlow, 0.3, { Transparency = 1 })
			end
		end)

		render(default, false)
		task.spawn(callback, default)
		register(row, text, nil, keywords)
		return { Set = function(v) setValue(math.clamp(v, min, max)) end }
	end

	-- Кнопка
	function tab.Button(text, callback, keywords)
		local row, layer = baseRow(40)
		local btn = new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextColor3 = "@text",
			AutoButtonColor = false,
			ZIndex = 3,
		}, row)
		hover(row, btn)
		connect(btn.InputBegan, function(input)
			if isPress(input) then ripple(layer, input.Position.X) end
		end)
		connect(btn.MouseButton1Click, function()
			task.spawn(function()
				tween(row, 0.08, { BackgroundColor3 = THEME.accent }).Completed:Wait()
				tween(row, 0.35, { BackgroundColor3 = THEME.element })
			end)
			task.spawn(callback)
		end)
		register(row, text, nil, keywords)
	end

	-- Текст (возвращает TextLabel, чтобы можно было менять текст)
	function tab.Label(text, height)
		local row = baseRow(height or 40)
		return new("TextLabel", {
			Position = UDim2.new(0, 12, 0, 0),
			Size = UDim2.new(1, -24, 1, 0),
			BackgroundTransparency = 1,
			Text = text,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = "@sub",
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
	end

	-- Сегментированный выбор (несколько вариантов)
	function tab.Choice(text, options, default, callback, keywords)
		local row = baseRow(58)
		rowLabel(row, text, 6, 1)
		local seg = new("Frame", {
			Position = UDim2.new(0, 14, 0, 30),
			Size = UDim2.new(1, -28, 0, 22),
			BackgroundColor3 = "@off",
			BackgroundTransparency = 0.35,
		}, row)
		corner(seg, 8)
		local n = #options
		local hl = new("Frame", {
			Size = UDim2.new(1 / n, -4, 1, -4),
			Position = UDim2.new(0, 2, 0, 2),
			BackgroundColor3 = "@accent",
			BorderSizePixel = 0,
		}, seg)
		corner(hl, 6)
		local buttons, current = {}, nil
		local function pick(name2, silent)
			current = name2
			for i, opt in ipairs(options) do
				local on = (opt == name2)
				if on then
					tween(hl, 0.35, { Position = UDim2.new((i - 1) / n, 2, 0, 2) }, Enum.EasingStyle.Back)
				end
				tween(buttons[opt], 0.25, { TextColor3 = on and THEME.text or THEME.sub })
			end
			if not silent then task.spawn(callback, name2) end
		end
		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				Position = UDim2.new((i - 1) / n, 0, 0, 0),
				Size = UDim2.new(1 / n, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = opt,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = THEME.sub,
				AutoButtonColor = false,
				ZIndex = 3,
			}, seg)
			buttons[opt] = b
			connect(b.MouseButton1Click, function() pick(opt) end)
		end
		table.insert(refreshers, function()
			for _, opt in ipairs(options) do
				tween(buttons[opt], 0.3, { TextColor3 = (opt == current) and THEME.text or THEME.sub })
			end
		end)
		pick(default, true)
		register(row, text, table.concat(options, " "), keywords)
	end

	-- Кружки-образцы. list = { {name=, seq=ColorSequence}, ... }
	function tab.ColorPick(text, list, default, callback, keywords)
		local row = baseRow(68)
		rowLabel(row, text, 8, 0.5)
		local valueLabel = rowValue(row, 8)
		local buttons = {}
		local function pick(name2, silent)
			valueLabel.Text = name2
			for n, b in pairs(buttons) do
				local on = (n == name2)
				tween(b.stroke, 0.25, { Transparency = on and 0 or 0.85 })
				tween(b.scale, 0.35, { Scale = on and 1.2 or 1 }, Enum.EasingStyle.Back)
			end
			if not silent then task.spawn(callback, name2) end
		end
		for i, entry in ipairs(list) do
			local sw = new("TextButton", {
				Position = UDim2.fromOffset(16 + (i - 1) * 26, 38),
				Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Text = "",
				AutoButtonColor = false,
				ZIndex = 3,
			}, row)
			roundCorner(sw)
			new("UIGradient", { Color = entry.seq, Rotation = 45 }, sw)
			buttons[entry.name] = {
				stroke = stroke(sw, Color3.new(1, 1, 1), 2, 0.85),
				scale = new("UIScale", {}, sw),
			}
			connect(sw.MouseButton1Click, function() pick(entry.name) end)
		end
		pick(default, true)
		register(row, text, nil, keywords)
	end

	-- Выбор темы (цветные кружки)
	function tab.Swatches(text, names, callback)
		local row = baseRow(48)
		new("TextLabel", {
			Position = UDim2.new(0, 14, 0, 0),
			Size = UDim2.new(0.3, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextColor3 = "@text",
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
		local buttons = {}
		local function pick(name2, silent)
			for n, b in pairs(buttons) do
				local on = (n == name2)
				tween(b.stroke, 0.25, { Transparency = on and 0 or 0.85 })
				tween(b.scale, 0.35, { Scale = on and 1.2 or 1 }, Enum.EasingStyle.Back)
			end
			if not silent then task.spawn(callback, name2) end
		end
		for i, name2 in ipairs(names) do
			local th = THEMES[name2]
			local sw = new("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14 - (#names - i) * 32, 0.5, 0),
