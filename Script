local Access = { tier = nil }
local lockables = {}           -- строки с замком (обновляются при смене ключа)
local keyEvent = Instance.new("BindableEvent")

local function allowed(tiers)
	if tiers == nil then return true end
	return Access.tier ~= nil and tiers[Access.tier] == true
end

local function tierText(tiers)
	local list = {}
	for _, name in ipairs(TIER_ORDER) do
		if tiers[name] then table.insert(list, name) end
	end
	return table.concat(list, " / ")
end

-- Возвращает уровень, которому соответствует введённый ключ (или nil)
local function matchKey(str)
	str = string.match(str or "", "^%s*(.-)%s*$")
	if str == "" then return nil end
	for _, tier in ipairs(TIER_ORDER) do
		local k = CONFIG.Keys[tier]
		if type(k) == "string" and k ~= "" and str == k then return tier end
	end
	return nil
end

local function saveKey(k)
	if not (CONFIG.SaveKey and writefile) then return end
	pcall(writefile, CONFIG.KeyFile, k)
end

local function loadKey()
	if not (CONFIG.SaveKey and isfile and readfile) then return nil end
	local ok, res = pcall(function()
		if isfile(CONFIG.KeyFile) then return readfile(CONFIG.KeyFile) end
		return nil
	end)
	if ok and type(res) == "string" and res ~= "" then return res end
	return nil
end

local function clearKey()
	pcall(function()
		if isfile and isfile(CONFIG.KeyFile) then
			if delfile then delfile(CONFIG.KeyFile) elseif writefile then writefile(CONFIG.KeyFile, "") end
		end
	end)
end

