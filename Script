do
	local flyVel, flyGyro, flyConn
	local ControlModule

	local flyPad = new("Frame", {
		Name = "FlyPad",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -20, 0.5, 0),
		Size = UDim2.fromOffset(56, 120),
		BackgroundTransparency = 1,
		Visible = false,
	}, gui)
	local padScale = new("UIScale", { Scale = 0 }, flyPad)

	local function padButton(text, y, onChange)
		local b = new("TextButton", {
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.fromOffset(56, 56),
			BackgroundColor3 = "@bg",
			BackgroundTransparency = 0.1,
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 20,
			TextColor3 = "@accent2",
			AutoButtonColor = false,
		}, flyPad)
		roundCorner(b)
		stroke(b, "@accent", 2, 0.1)
		connect(b.InputBegan, function(input)
			if isPress(input) then
				onChange(true)
				tween(b, 0.1, { BackgroundColor3 = THEME.accent, BackgroundTransparency = 0 })
			end
		end)
		connect(b.InputEnded, function(input)
			if isPress(input) then
				onChange(false)
				tween(b, 0.25, { BackgroundColor3 = THEME.bg, BackgroundTransparency = 0.1 })
			end
		end)
	end
	padButton("▲", 0, function(v) Keys.up = v end)
	padButton("▼", 64, function(v) Keys.dn = v end)

	local function showPad(show)
		if not UIS.TouchEnabled then return end
		if show then
			flyPad.Visible = true
			tween(padScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			Keys.up, Keys.dn = false, false
			tween(padScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.22, function()
				if not Fly.enabled then flyPad.Visible = false end
			end)
		end
	end
	F.hidePad = function() tween(padScale, 0.2, { Scale = 0 }) end

	task.spawn(function()
		local ok, mod = pcall(function()
			local ps = LocalPlayer:WaitForChild("PlayerScripts", 5)
			local pm = ps:WaitForChild("PlayerModule", 5)
			return require(pm:WaitForChild("ControlModule", 5))
		end)
		if ok then ControlModule = mod end
	end)

	local function getMoveDir(humanoid, camCF)
		if ControlModule then
			local ok, mv = pcall(ControlModule.GetMoveVector, ControlModule)
			if ok and typeof(mv) == "Vector3" then
				return camCF.RightVector * mv.X + camCF.LookVector * -mv.Z
			end
		end
		local md = humanoid.MoveDirection
		if md.Magnitude < 0.01 then return Vector3.zero end
		local look, right = camCF.LookVector, camCF.RightVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
		local flatRight = Vector3.new(right.X, 0, right.Z).Unit
		return look * md:Dot(flatLook) + right * md:Dot(flatRight)
	end

	local function getVertical()
		local d = Keys.down
		local up = d[Enum.KeyCode.Space] or d[Enum.KeyCode.E] or Keys.up
		local down = d[Enum.KeyCode.Q] or d[Enum.KeyCode.LeftControl] or Keys.dn
		return (up and 1 or 0) - (down and 1 or 0)
	end

	local function cleanupFly()
		if flyConn then flyConn:Disconnect() flyConn = nil end
		if flyVel then flyVel:Destroy() flyVel = nil end
		if flyGyro then flyGyro:Destroy() flyGyro = nil end
		local _, _, hum = getChar()
		if hum then hum.PlatformStand = false end
	end

	local function startFly()
		cleanupFly()
		local _, hrp, hum = getChar()
		if not hrp or not hum then return end

		flyVel = new("BodyVelocity", {
			MaxForce = Vector3.new(9e9, 9e9, 9e9),
			Velocity = Vector3.zero,
		}, hrp)
		flyGyro = new("BodyGyro", {
			MaxTorque = Vector3.new(9e9, 9e9, 9e9),
			P = 9e4,
			D = 1e3,
			CFrame = hrp.CFrame,
		}, hrp)
		hum.PlatformStand = true

		flyConn = RunService.RenderStepped:Connect(function(dt)
			local _, rootPart, humanoid = getChar()
			local cam = workspace.CurrentCamera
			if not (rootPart and humanoid and cam and flyVel and flyVel.Parent == rootPart) then return end

			humanoid.PlatformStand = true
			local camCF = cam.CFrame
			local target = getMoveDir(humanoid, camCF) + Vector3.new(0, getVertical(), 0)
			if target.Magnitude > 1 then target = target.Unit end

			flyVel.Velocity = flyVel.Velocity:Lerp(target * Fly.speed, math.clamp(dt * 12, 0, 1))

			local look = camCF.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.05 then
				flyGyro.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + flat)
			end
		end)
	end

	F.setFly = function(state)
		Fly.enabled = state
		if state then startFly() else cleanupFly() end
		showPad(state)
	end
	F.restartFly = function()
		if Fly.enabled then startFly() end
	end
end

connect(UIS.InputBegan, function(input, gp)
