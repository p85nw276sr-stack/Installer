local function httpGet(url)
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and type(res) == "string" and #res > 0 then return true, res end
	local ok2, r = pcall(function()
		local req = request or http_request or (syn and syn.request)
		if not req then error("no request function") end
		return req({ Url = url, Method = "GET" })
	end)
	if ok2 and type(r) == "table" and type(r.Body) == "string" and #r.Body > 0 then
		return true, r.Body
	end
	return false, tostring(res)
end

local function copyText(text)
	local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if not fn then return false end
	return (pcall(fn, text))
end

local function findPlayer(str)
	str = string.lower(string.match(str or "", "^%s*(.-)%s*$"))
	if str == "" then return nil end
	local best
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local n, d = p.Name:lower(), p.DisplayName:lower()
			if n == str or d == str then return p end
			if not best and (n:sub(1, #str) == str or d:sub(1, #str) == str) then best = p end
		end
	end
	if best then return best end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and (p.Name:lower():find(str, 1, true) or p.DisplayName:lower():find(str, 1, true)) then
			return p
		end
	end
	return nil
end

