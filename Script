-- Открывает / закрывает замки на строках под текущий уровень
local function applyAccess()
	local alive = {}
	for _, e in ipairs(lockables) do
		if e.lock and e.lock.Parent then
			table.insert(alive, e)
			local ok = allowed(e.tiers)
			e.lock.Visible = not ok
			if not ok and e.reset then pcall(e.reset) end
		end
	end
	lockables = alive

	local tier = Access.tier
	userLabel.Text = tier and (LocalPlayer.DisplayName .. "  ·  " .. tier) or LocalPlayer.DisplayName
	accountLabel.Text = tier and ("Доступ: " .. tier .. " - " .. TIER_INFO[tier]) or "Ключ не введён"
end

local function login(tier)
	Access.tier = tier
	applyAccess()
end

