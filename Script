	local function colorDragon(d)
		local main = THEME[d.colorKey]
		local dark = main:Lerp(Color3.new(0, 0, 0), 0.55)
		for i, seg in ipairs(d.segs) do
			local t = (i - 1) / (DRAGON_N - 1)
			local c = main:Lerp(dark, t * 0.75)
			if i % 2 == 0 then c = c:Lerp(Color3.new(1, 1, 1), 0.1) end
			seg.BackgroundColor3 = c
		end
		d.head.BackgroundColor3 = main:Lerp(Color3.new(1, 1, 1), 0.12)
		d.snout.BackgroundColor3 = main:Lerp(Color3.new(1, 1, 1), 0.22)
		d.jaw.BackgroundColor3 = main:Lerp(dark, 0.35)
	end

	local dragons = {
		newDragon("accent2", 0, 0.45),
		newDragon("accent", math.pi, -0.45),
	}
	for _, d in ipairs(dragons) do
		colorDragon(d)
		table.insert(refreshers, function() colorDragon(d) end)
	end

	-- Точка на наклонной эллиптической орбите + "глубина" (спереди / сзади жемчужины)
	local function orbitPoint(d, a, wob)
		local x = math.cos(a) * (ORBIT_RX + wob)
		local y = math.sin(a) * (ORBIT_RY + wob * 0.45)
		local c, s = math.cos(d.tilt), math.sin(d.tilt)
		return FAB_C + x * c - y * s, FAB_C + x * s + y * c, math.sin(a)
	end

	-- спереди жемчужины (ZIndex 6..18) или за ней (ZIndex 2..4)
	local function depthZ(depth)
		if depth >= 0 then
			return 6 + math.floor(depth * 12)
		end
		return 2 + math.floor((depth + 1) * 2.99)
	end

	local function setZ(frame, z)
		if frame.ZIndex ~= z then frame.ZIndex = z end
	end

	local function updateDragon(d, clock)
		local theta = clock + d.phase + math.sin(clock * 0.55 + d.phase) * 0.3
		local pts = d.pts
		for i = 0, DRAGON_N do
			local a = theta - i * ANG_STEP
			local wob = math.sin(clock * 2.6 + i * 0.5 + d.phase) * 2.4
			local x, y, depth = orbitPoint(d, a, wob)
			local p = pts[i]
			if not p then
				p = {}
				pts[i] = p
			end
			p[1], p[2], p[3] = x, y, depth
		end

		-- тело
		for i = 1, DRAGON_N do
			local p = pts[i]
			local seg = d.segs[i]
			local tt = (i - 1) / (DRAGON_N - 1)
			local size = (3 + 8.5 * (1 - tt) ^ 0.85) * (1 + 0.28 * p[3])
			seg.Size = UDim2.fromOffset(size, size)
			seg.Position = UDim2.fromOffset(p[1], p[2])
			setZ(seg, depthZ(p[3]))
			local sp = d.spikes[i]
			if sp then
				sp.Rotation = math.deg(math.atan2(p[2] - FAB_C, p[1] - FAB_C))
			end
		end

		-- хвостовой веер
		local last, prev = pts[DRAGON_N], pts[DRAGON_N - 1]
		local tailAng = math.deg(math.atan2(last[2] - prev[2], last[1] - prev[1]))
		local fan = { 0, 32, -32 }
		for k = 1, 3 do
			d.plume[k].Rotation = tailAng + fan[k] + math.sin(clock * 5 + k) * 6
		end

		-- голова
		local h = pts[0]
		local nx, ny = orbitPoint(d, theta + 0.04, math.sin(clock * 2.6 + d.phase) * 2.4)
		d.head.Position = UDim2.fromOffset(h[1], h[2])
		d.head.Rotation = math.deg(math.atan2(ny - h[2], nx - h[1]))
		d.headScale.Scale = 1 + 0.28 * h[3]
		setZ(d.head, depthZ(h[3]))
		d.jaw.Rotation = 6 + math.sin(clock * 3.2 + d.phase) * 7
		for side = 1, 2 do
			local w = d.whisk[side]
			local sgn = (side == 1) and 1 or -1
			w[2].Rotation = (-10 + math.sin(clock * 4 + side) * 14) * sgn
			w[3].Rotation = (18 + math.sin(clock * 4 + side + 1) * 16) * sgn
		end
	end

	local fabHit = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 60,
	}, fab)

	-- Расходящиеся кольца при открытии / закрытии
	Pearl.burst = function()
		for i = 1, 2 do
			task.delay((i - 1) * 0.14, function()
				if not fab.Parent then return end
				local ring = new("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(46, 46),
					BackgroundTransparency = 1,
					ZIndex = 2,
				}, fab)
				roundCorner(ring)
				local st = stroke(ring, THEME.accent2, 2.5, 0.1)
				tween(ring, 0.8, { Size = UDim2.fromOffset(160, 160) })
				tween(st, 0.8, { Transparency = 1 }).Completed:Connect(function()
					ring:Destroy()
				end)
			end)
		end
	end

	Pearl.center = function()
		local p, s = fab.AbsolutePosition, fab.AbsoluteSize
		return UDim2.fromOffset(p.X + s.X / 2, p.Y + s.Y / 2)
	end

	Pearl.fab = fab
	Pearl.scale = fabScale
	Pearl.hit = fabHit

	local dClock, dSpeed = 0, 1.8
	Pearl.update = function(dt, t)
		-- драконы: быстрее, когда меню закрыто, и спокойнее, когда открыто
		local targetSpeed = Pearl.menuOpen and 1.1 or 1.9
		dSpeed = dSpeed + (targetSpeed - dSpeed) * math.clamp(dt * 3, 0, 1)
		dClock = dClock + dt * dSpeed
		for _, d in ipairs(dragons) do updateDragon(d, dClock) end

		-- жемчужина: «дыхание», переливы, блик, мерцание
		pearlScale.Scale = 1 + math.sin(t * 2.2) * 0.04
		pearlGrad.Rotation = (45 + t * 70) % 360
		gloss.BackgroundTransparency = 0.7 + math.sin(t * 2.2) * 0.1
		local ph = (t * 0.7) % 1
		halo.Size = UDim2.fromOffset(48 + ph * 30, 48 + ph * 30)
		haloStroke.Transparency = 0.25 + ph * 0.75
		for _, s in ipairs(sparkles) do
			local k = (math.sin(t * 2.4 + s.ph) + 1) / 2
			s.f.Size = UDim2.fromOffset(2 + k * 4, 2 + k * 4)
			s.f.BackgroundTransparency = 0.15 + (1 - k) * 0.8
		end
	end
end

----------------------------------------------------------------
-- Вкладки: состояние и анимации
----------------------------------------------------------------
local tabs, currentTab = {}, nil
local allRows = {}      -- все строки с функциями (для поиска)
local searching = false
local lastRealTab
local searchTab, searchInfo

local function popRows(tab)
	for i, sc in ipairs(tab.rowScales) do
		sc.Scale = 0.88
		task.delay(0.04 * math.min(i, 10), function()
			if sc.Parent then tween(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end
		end)
	end
end

local function refreshTabs()
	for _, t in ipairs(tabs) do
		-- вкладка остаётся подсвеченной, пока открыта её скрытая подстраница (страница игры)
		local on = (t == currentTab) or (currentTab ~= nil and currentTab.parentTab == t)
		tween(t.btn, 0.25, { TextColor3 = on and THEME.text or THEME.sub })
		tween(t.pad, 0.3, { PaddingLeft = UDim.new(0, on and 22 or 16) }, Enum.EasingStyle.Back)
	end
end
table.insert(refreshers, refreshTabs)

-- dx - необязательный сдвиг по горизонтали для анимации появления страницы (вход/возврат)
local function selectTab(tab, dx)
	if currentTab == tab then return end
	if currentTab then
		local old = currentTab
		tween(old.page, 0.15, { GroupTransparency = 1 })
		task.delay(0.16, function()
			if currentTab ~= old then old.page.Visible = false end
		end)
	end
	currentTab = tab
	headerTitle.Text = tab.name

	tab.page.Visible = true
	tab.page.GroupTransparency = 1
	tab.page.Position = dx and UDim2.new(0, dx, 0, 0) or UDim2.new(0, 0, 0, 16)
	tween(tab.page, 0.4, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })

	local anchor = tab.parentTab or tab
	if tab.hidden and not tab.parentTab then
		indicator.Visible = false
	else
		indicator.Visible = true
		tween(indicator, 0.4, { Position = UDim2.new(0, 8, 0, anchor.y) }, Enum.EasingStyle.Back)
	end
	refreshTabs()
	popRows(tab)
	if tab.onShow then task.spawn(tab.onShow) end
end

-- возвращает все найденные строки на свои места
local function restoreRows()
	for _, e in ipairs(allRows) do
		if e.row.Parent ~= e.home then
			e.row.Parent = e.home
			e.row.LayoutOrder = e.order
		end
	end
end

