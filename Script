		for side = 1, 2 do
			local sgn = (side == 1) and 1 or -1
			local p1 = limb(head, UDim2.fromOffset(17, side == 1 and 3.2 or 8.8), 9, 1.5, -28 * sgn, pale)
			local p2 = limb(p1, UDim2.new(1, 0, 0.5, 0), 8, 1.2, -10 * sgn, pale)
			local p3 = limb(p2, UDim2.new(1, 0, 0.5, 0), 7, 1, 18 * sgn, pale)
