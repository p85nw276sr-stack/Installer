	do
		local list = {}
		for _, g in ipairs(GAMES) do
			if isHere(g) then table.insert(list, g) end
		end
		for _, g in ipairs(GAMES) do
			if not isHere(g) and not g.places then table.insert(list, g) end
		end
		for _, g in ipairs(GAMES) do
			if not isHere(g) and g.places then table.insert(list, g) end
		end
		for i, g in ipairs(list) do buildCard(g, i) end
	end

	-- карточки заново "выезжают" каждый раз, когда открываешь вкладку
	gamesTab.onShow = function()
		for i, c in ipairs(gameCards) do
			c.enter = 0
			c.delay = 0.04 * math.min(i, 12)
		end
	end

	-- Анимация прокрутки: карточки у краёв списка уменьшаются и тают, центральные - крупные;
	-- при появлении вкладки выезжают справа по очереди. Далёкие от экрана карточки скрываются.
	connect(RunService.RenderStepped, function(dt)
		local active = (currentTab == gamesTab)
		local sc = gamesTab.scroll
		local vpY = sc.AbsolutePosition.Y
		local vpH = math.max(sc.AbsoluteSize.Y, 1)
		for _, c in ipairs(gameCards) do
			local f = c.frame
			if active and f.Parent == sc then
				c.plain = false
				if c.delay > 0 then
					c.delay = c.delay - dt
				elseif c.enter < 1 then
					c.enter = math.min(1, c.enter + dt * 3.2)
				end
				local e = 1 - (1 - c.enter) ^ 3
				local mid = f.AbsolutePosition.Y + f.AbsoluteSize.Y / 2
				local n = math.abs(mid - (vpY + vpH / 2)) / (vpH / 2)
				local edge = math.clamp((n - 0.5) / 0.7, 0, 1)
				local off = n > 1.3
				if c.group.Visible == off then c.group.Visible = not off end
				if not off then
					c.scale.Scale = (1 - 0.16 * edge * edge) * (0.86 + 0.14 * e)
					c.group.GroupTransparency = 1 - (1 - 0.8 * edge) * e
					c.group.Position = UDim2.new(0.5, (1 - e) * 46 + edge * 6, 0.5, 0)
				end
			elseif f.Parent ~= sc then
				-- карточка в результатах поиска: показываем как есть
				if not c.plain then
					c.plain = true
					c.group.Visible = true
					c.scale.Scale = 1
					c.group.GroupTransparency = 0
					c.group.Position = UDim2.fromScale(0.5, 0.5)
				end
			end
		end
	end)
end

