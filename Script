F.setWalk = function(on)
	State.walkOn = on
	local _, _, hum = getChar()
	if not hum then return end
	if on then
		orig.walk = hum.WalkSpeed
	else
		hum.WalkSpeed = orig.walk or 16
	end
end

F.setJump = function(on)
	State.jumpOn = on
	local _, _, hum = getChar()
	if not hum then return end
	if on then
		orig.useJP, orig.jp, orig.jh = hum.UseJumpPower, hum.JumpPower, hum.JumpHeight
	elseif orig.useJP ~= nil then
		hum.UseJumpPower = orig.useJP
		hum.JumpPower = orig.jp
		hum.JumpHeight = orig.jh
	end
end

do
	local touched = setmetatable({}, { __mode = "k" })
	F.setNoclip = function(on)
		State.noclip = on
		if not on then
			for part in pairs(touched) do
				if part and part.Parent then part.CanCollide = true end
			end
			touched = setmetatable({}, { __mode = "k" })
		end
	end
	connect(RunService.Stepped, function()
		if not State.noclip then return end
		local char = LocalPlayer.Character
		if not char then return end
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				touched[p] = true
				p.CanCollide = false
			end
		end
	end)
end

F.setGod = function(on)
	State.god = on
	if not on then
		local char, _, hum = getChar()
		if hum then
			pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end)
		end
		local ff = char and char:FindFirstChild("InstFF")
		if ff then ff:Destroy() end
	end
end

F.setFreeze = function(on)
	State.freeze = on
	if not on then
		local _, hrp = getChar()
		if hrp then hrp.Anchored = false end
	end
end

do
	local spinObj
	F.setSpin = function(on)
		State.spin = on
		if spinObj then
			spinObj:Destroy()
			spinObj = nil
		end
		if on then
			local _, hrp = getChar()
			if hrp then
				spinObj = Instance.new("BodyAngularVelocity")
				spinObj.Name = "InstSpin"
				spinObj.MaxTorque = Vector3.new(0, 9e9, 0)
				spinObj.P = 1e5
				spinObj.AngularVelocity = Vector3.new(0, State.spinSpeed, 0)
				spinObj.Parent = hrp
			end
		end
	end
	F.setSpinSpeed = function(v)
		State.spinSpeed = v
		if spinObj and spinObj.Parent then
			spinObj.AngularVelocity = Vector3.new(0, v, 0)
		end
	end
end

