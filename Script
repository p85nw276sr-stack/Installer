----------------------------------------------------------------
-- Мир: Fullbright, No Fog, время, гравитация, FOV, зум
-- Каждое изменение запоминает оригинал и возвращает его при выключении.
----------------------------------------------------------------
do
	local held = {}

	local function hold(inst, prop, value)
		local h = held[inst]
		if not h then
			h = {}
			held[inst] = h
		end
		if h[prop] == nil then h[prop] = inst[prop] end
		if inst[prop] ~= value then inst[prop] = value end
	end

	local function release(inst, prop)
		local h = held[inst]
		if h and h[prop] ~= nil then
			local v = h[prop]
			h[prop] = nil
			pcall(function() inst[prop] = v end)
		end
	end

	F.applyWorld = function()
		local any = State.fullbright or State.noFog or State.timeOn
			or State.gravOn or State.fovOn or State.zoom
		if not any and next(held) == nil then return end

		local want = {}
		local function w(inst, prop, value)
			local t = want[inst]
			if not t then
				t = {}
				want[inst] = t
			end
			t[prop] = value
		end

		if State.fullbright then
			w(Lighting, "Brightness", 2)
			w(Lighting, "GlobalShadows", false)
			w(Lighting, "Ambient", rgb(170, 170, 170))
			w(Lighting, "OutdoorAmbient", rgb(170, 170, 170))
		end
		if State.timeOn then
			w(Lighting, "ClockTime", State.time)
		elseif State.fullbright then
			w(Lighting, "ClockTime", 14)
		end
		if State.noFog then
			w(Lighting, "FogEnd", 1e6)
			for _, c in ipairs(Lighting:GetChildren()) do
				if c:IsA("Atmosphere") then
					w(c, "Density", 0)
					w(c, "Haze", 0)
				end
			end
		end
		if State.gravOn then
			w(workspace, "Gravity", State.grav)
		end
		if State.fovOn then
			local cam = workspace.CurrentCamera
			if cam then w(cam, "FieldOfView", State.fov) end
		end
		if State.zoom then
			w(LocalPlayer, "CameraMaxZoomDistance", 1e5)
			w(LocalPlayer, "CameraMinZoomDistance", 0)
		end

		for inst, props in pairs(want) do
			for prop, value in pairs(props) do
				pcall(hold, inst, prop, value)
			end
		end
		for inst, props in pairs(held) do
			for prop in pairs(props) do
				local wp = want[inst]
				if not (wp and wp[prop] ~= nil) then release(inst, prop) end
			end
		end
	end
end

----------------------------------------------------------------
-- Главный цикл персонажа (Heartbeat)
----------------------------------------------------------------
do
	local lastSafe
	F.resetSafe = function() lastSafe = nil end

	connect(RunService.Heartbeat, function()
		local char, hrp, hum = getChar()

		-- наблюдение: камера следует за целью
		local sp = F.spec
		if sp.on then
			local tp = sp.target
			local th = tp and tp.Parent and tp.Character and tp.Character:FindFirstChildOfClass("Humanoid")
			local cam = workspace.CurrentCamera
			if th and cam then
				if cam.CameraSubject ~= th then cam.CameraSubject = th end
			else
				F.stopSpectate()
				toast("Игрок вышел, наблюдение остановлено", "info")
			end
		end

		if not hum then return end

		if State.walkOn and hum.WalkSpeed ~= State.walk then
			hum.WalkSpeed = State.walk
		end
		if State.jumpOn then
			if not hum.UseJumpPower then hum.UseJumpPower = true end
			if hum.JumpPower ~= State.jump then hum.JumpPower = State.jump end
		end
		if State.god then
			if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
			if hum:GetStateEnabled(Enum.HumanoidStateType.Dead) then
				hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
			end
			if not char:FindFirstChild("InstFF") then
				local ff = Instance.new("ForceField")
				ff.Name = "InstFF"
				ff.Visible = false
				ff.Parent = char
			end
		end
		if State.freeze and hrp and not hrp.Anchored then
			hrp.Anchored = true
		end

		-- Bunny Hop: пробел на ПК, на телефоне - пока двигаешься
		if State.bhop and not Fly.enabled and hum.FloorMaterial ~= Enum.Material.Air then
			local want = UIS:IsKeyDown(Enum.KeyCode.Space)
				or (UIS.TouchEnabled and not UIS.KeyboardEnabled and hum.MoveDirection.Magnitude > 0.1)
			if want then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end

		-- Anti-Void: возвращает на последнюю безопасную точку
		if State.antiVoid and hrp then
			local limit = math.max(workspace.FallenPartsDestroyHeight, -5000) + 40
			if hrp.Position.Y < limit then
				if lastSafe then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.CFrame = lastSafe
				end
			elseif hum.FloorMaterial ~= Enum.Material.Air then
				lastSafe = hrp.CFrame + Vector3.new(0, 3, 0)
			end
		end
	end)
end

