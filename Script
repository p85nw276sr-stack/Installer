	local q = string.lower(string.match(searchBox.Text, "^%s*(.-)%s*$"))
	if q == "" then
		if searching then
			searching = false
			restoreRows()
			selectTab(lastRealTab or tabs[1])
		end
		return
	end
	if not searching then
		searching = true
		lastRealTab = currentTab
		selectTab(searchTab)
	end
	runSearch(q)
end)

