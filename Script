			}
			connect(sw.MouseButton1Click, function() pick(name2) end)
		end
		pick("Dragon", true)
		register(row, text, "colors", "тема цвета")
	end

	-- Поле ввода. big = true -> многострочное поле (для кода)
	function tab.Input(text, placeholder, callback, big, keywords)
		local row = baseRow(big and 136 or 66)
		rowLabel(row, text, 6, 1)
		local box = new("TextBox", {
			Position = UDim2.new(0, 14, 0, 30),
			Size = UDim2.new(1, -28, 0, big and 96 or 28),
			BackgroundColor3 = "@off",
			BackgroundTransparency = 0.35,
			Text = "",
			PlaceholderText = placeholder or "",
			PlaceholderColor3 = "@sub",
			TextColor3 = "@text",
			Font = Enum.Font.Gotham,
			TextSize = 13,
			ClearTextOnFocus = false,
			MultiLine = big and true or false,
			TextWrapped = big and true or false,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = big and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
			ClipsDescendants = true,
			ZIndex = 3,
		}, row)
		corner(box, 8)
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, big and 8 or 0),
		}, box)
		local st = stroke(box, "@stroke", 1.2, 0.2)
		connect(box.Focused, function() tween(st, 0.2, { Color = THEME.accent2 }) end)
		connect(box.FocusLost, function(enter)
			tween(st, 0.25, { Color = THEME.stroke })
			if callback then task.spawn(callback, box.Text, enter) end
		end)
		register(row, text, placeholder, keywords)
		return {
			Get = function() return box.Text end,
			Set = function(v) box.Text = v end,
		}
	end

	-- Карточка скрипта: иконка, название, описание, статус и кнопка Run.
	-- url: строка, список запасных ссылок или функция(status) -> true/false
	function tab.ScriptCard(title, desc, tag, url, keywords)
		local row = baseRow(80)
		local icon = new("Frame", {
			Position = UDim2.fromOffset(12, 18),
			Size = UDim2.fromOffset(44, 44),
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, row)
		corner(icon, 10)
		accentGradient(icon, 45)
		new("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = tag,
			Font = Enum.Font.GothamBold,
			TextSize = 17,
			TextColor3 = rgb(255, 242, 205),
		}, icon)
		new("TextLabel", {
			Position = UDim2.fromOffset(68, 9),
			Size = UDim2.new(1, -176, 0, 18),
			BackgroundTransparency = 1,
			Text = title,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = "@text",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, row)
		new("TextLabel", {
			Position = UDim2.fromOffset(68, 28),
			Size = UDim2.new(1, -176, 0, 28),
			BackgroundTransparency = 1,
			Text = desc,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = "@sub",
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		}, row)
		local status = new("TextLabel", {
			Position = UDim2.fromOffset(68, 60),
			Size = UDim2.new(1, -176, 0, 14),
			BackgroundTransparency = 1,
			Text = "Готов к запуску",
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = "@sub",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, row)
		local function setStatus(txt, kind)
			status.Text = txt
			local col = (kind == "err" and rgb(235, 90, 100)) or (kind == "ok" and rgb(90, 210, 130))
				or (kind == "info" and THEME.accent2) or THEME.sub
			tween(status, 0.2, { TextColor3 = col })
		end

		local btn = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(84, 32),
			BackgroundColor3 = "@accent",
			Text = "Run",
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = Color3.new(1, 1, 1),
			AutoButtonColor = false,
			ZIndex = 3,
		}, row)
		corner(btn, 8)
		connect(btn.MouseEnter, function() tween(btn, 0.15, { BackgroundTransparency = 0.2 }) end)
		connect(btn.MouseLeave, function() tween(btn, 0.2, { BackgroundTransparency = 0 }) end)

		local busy = false
		connect(btn.MouseButton1Click, function()
			if busy then return end
			busy = true
			btn.Text = "..."
			task.spawn(function()
				local ok
				if type(url) == "function" then
					ok = url(setStatus)
				else
					ok = F.runUrl(url, title, setStatus)
				end
				busy = false
				btn.Text = ok and "Again" or "Retry"
			end)
		end)
		register(row, title, desc, keywords)
	end

	if not hidden then table.insert(tabs, tab) end
	return tab
end

