		connect(cam0:GetPropertyChangedSignal("ViewportSize"), function()
			if menuVisible then tween(uiScale, 0.25, { Scale = currentScale() }) end
		end)
	end
end

makeDraggable(Pearl.hit, Pearl.fab, function()
