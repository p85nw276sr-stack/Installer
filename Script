searchTab = createTab("Search", true)
searchInfo = new("TextLabel", {
	LayoutOrder = 0,
	Size = UDim2.new(1, 0, 0, 22),
	BackgroundTransparency = 1,
	Text = "",
	Font = Enum.Font.GothamBold,
	TextSize = 12,
	TextColor3 = "@accent2",
	TextXAlignment = Enum.TextXAlignment.Left,
}, searchTab.scroll)

local function runSearch(q)
	restoreRows()
	local n = 0
	for _, e in ipairs(allRows) do
		if e.text:find(q, 1, true) then
			n = n + 1
			e.row.Parent = searchTab.scroll
			e.row.LayoutOrder = n + 1
		end
	end
	searchInfo.Text = (n > 0) and ("Найдено функций: " .. n) or "Ничего не найдено"
end

-- выйти из режима поиска (например, когда открываем страницу игры из результатов)
local function exitSearch()
	if searching then
		searching = false
		restoreRows()
		searchBox.Text = ""
	end
end

