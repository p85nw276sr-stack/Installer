-- url может быть строкой или списком запасных ссылок
F.runUrl = function(url, label, status)
	status = status or function() end
	local list = (type(url) == "table") and url or { url }
	local src
	status("Скачиваю...", "info")
	for _, u in ipairs(list) do
		local ok, body = httpGet(u)
		if ok then
			src = body
			break
		end
	end
	if not src then
		status("Не удалось скачать", "err")
		toast(label .. ": не удалось скачать (проверь интернет)", "err")
		return false
	end
	local ls = loadstring
	if type(ls) ~= "function" then
		status("loadstring недоступен", "err")
		toast("В этом экзекуторе нет loadstring", "err")
		return false
	end
	local fn, cerr = ls(src)
	if not fn then
		status("Ошибка в скрипте", "err")
		toast(label .. ": " .. string.sub(tostring(cerr), 1, 90), "err")
		return false
	end
	status("Запускаю...", "info")
	local okR, rerr = pcall(fn)
	if not okR then
		status("Ошибка при запуске", "err")
		toast(label .. ": " .. string.sub(tostring(rerr), 1, 90), "err")
		return false
	end
	status("Запущено", "ok")
	toast(label .. " запущен", "ok")
	return true
end

F.runCode = function(code)
	if type(code) ~= "string" or string.match(code, "^%s*$") then
		toast("Поле кода пустое", "err")
		return false
	end
	local ls = loadstring
	if type(ls) ~= "function" then
		toast("В этом экзекуторе нет loadstring", "err")
		return false
	end
	local fn, cerr = ls(code)
	if not fn then
		toast("Ошибка: " .. string.sub(tostring(cerr), 1, 90), "err")
		return false
	end
	local ok, rerr = pcall(fn)
	if not ok then
		toast("Ошибка: " .. string.sub(tostring(rerr), 1, 90), "err")
		return false
	end
	toast("Код выполнен", "ok")
	return true
end

