local connections = {}
local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

-- new("Frame", { BackgroundColor3 = "@bg" })  ->  цвет берётся из темы и меняется вместе с ней
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if type(v) == "string" and v:sub(1, 1) == "@" then
			local key = v:sub(2)
			inst[k] = THEME[key]
			table.insert(bindings, { inst = inst, prop = k, key = key })
		else
			inst[k] = v
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function roundCorner(parent)
	return new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- Градиент в цветах темы. mode: nil (accent->accent2), "loop" (accent, accent2, accent), "shine" (золото с бликом)
local function accentGradient(parent, rotation, mode)
	local g = new("UIGradient", { Rotation = rotation or 0 }, parent)
	local function refresh()
		if mode == "loop" then
			g.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, THEME.accent),
				ColorSequenceKeypoint.new(0.5, THEME.accent2),
				ColorSequenceKeypoint.new(1, THEME.accent),
			})
		elseif mode == "shine" then
			g.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, THEME.accent2),
				ColorSequenceKeypoint.new(0.5, THEME.accent2:Lerp(Color3.new(1, 1, 1), 0.8)),
				ColorSequenceKeypoint.new(1, THEME.accent2),
			})
		else
			g.Color = ColorSequence.new(THEME.accent, THEME.accent2)
		end
	end
	refresh()
	table.insert(refreshers, refresh)
	return g
end

local function setTheme(name)
	local t = THEMES[name]
	if not t then return end
	for k, v in pairs(t) do THEME[k] = v end
	-- заодно выкидываем элементы, которые уже уничтожены
	local alive = {}
	for _, b in ipairs(bindings) do
		if b.inst.Parent then
			table.insert(alive, b)
			pcall(function() tween(b.inst, 0.5, { [b.prop] = THEME[b.key] }) end)
		end
	end
	bindings = alive
	for _, fn in ipairs(refreshers) do pcall(fn) end
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

-- Перетаскивание (мышь и палец). onClick - если почти не двигали, onEnd - при отпускании.
local function makeDraggable(handle, target, onClick, onEnd)
	local dragging, dragStart, startPos, moved = false, nil, nil, 0
	connect(handle.InputBegan, function(input)
		if isPress(input) then
			dragging = true
			moved = 0
			dragStart = input.Position
			startPos = target.Position
		end
	end)
	connect(UIS.InputChanged, function(input)
		if dragging and isMove(input) then
			local delta = input.Position - dragStart
			moved = math.max(moved, delta.Magnitude)
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	connect(UIS.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = false
			if onEnd then onEnd() end
			if onClick and moved < 6 then onClick() end
		end
	end)
end

