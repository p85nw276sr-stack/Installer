local function unload(animated)
	pcall(function() keyEvent:Fire(nil) end) -- если открыт экран ключа - он закроется

	local function destroyAll()
		for _, fn in ipairs({ F.setFly, F.setWalk, F.setJump, F.setGod, F.setNoclip, F.setSpin, F.setFreeze }) do
			pcall(fn, false)
		end
		pcall(F.stopSpectate, true)
		for _, k in ipairs({ "fullbright", "noFog", "timeOn", "gravOn", "fovOn", "zoom" }) do
			State[k] = false
		end
		pcall(F.applyWorld)
		pcall(function() RunService:UnbindFromRenderStep("InstallerScripts_Main") end)
		for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
		connections = {}
		if gui then gui:Destroy() end
		pcall(function() keyEvent:Destroy() end)
		env.InstallerScriptsUnload = nil
	end
	if animated then
		setMenuVisible(false)
		tween(Pearl.scale, 0.4, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		pcall(F.hidePad)
		ESP.enabled, Aim.enabled, Cham.enabled = false, false, false
		ESP.hideAll()
		Aim.circle.Visible = false
		Cross.holder.Visible = false
		HUD.frame.Visible = false
		task.delay(0.6, destroyAll)
	else
		destroyAll()
	end
end
env.InstallerScriptsUnload = unload

