local function targetPosition(char, kind)
	if kind == "Head" then
		local h = char:FindFirstChild("Head")
		return h and h.Position
	end
	local r = char:FindFirstChild("HumanoidRootPart")
	if not r then return nil end
	if kind == "Feet" then return r.Position - Vector3.new(0, 3, 0) end
	return r.Position
end

function ESP.update(cam, t)
	if not ESP.enabled then
		if ESP.wasOn then
			ESP.wasOn = false
			ESP.hideAll()
		end
		return
	end
	ESP.wasOn = true

	local vp = cam.ViewportSize
	local origin
	if ESP.origin == "Center" then
		origin = vp / 2
	elseif ESP.origin == "Top" then
		origin = Vector2.new(vp.X / 2, 0)
	else
		origin = Vector2.new(vp.X / 2, vp.Y)
	end

	local _, myRoot = getChar()
	local myPos = myRoot and myRoot.Position or cam.CFrame.Position
	local idx = 0

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			idx = idx + 1
			local o = ESP.getObject(plr)
			local show = false
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local pos = (hum and hum.Health > 0) and targetPosition(char, ESP.target) or nil

			if pos and isEnemy(plr, ESP.teamCheck) then
				local dist = (pos - myPos).Magnitude
				if ESP.maxDist >= DIST_MAX or dist <= ESP.maxDist then
					local v = cam:WorldToViewportPoint(pos)
					if v.Z > 0 then
						show = true
						local p2 = Vector2.new(v.X, v.Y)
						local d = p2 - origin
						local col = ESP.pickColor(ESP.color, plr, t, idx)

						local line = o.line
						line.Size = UDim2.fromOffset(d.Magnitude, ESP.thickness)
						line.Position = UDim2.fromOffset((origin.X + p2.X) / 2, (origin.Y + p2.Y) / 2)
						line.Rotation = math.deg(math.atan2(d.Y, d.X))
						line.BackgroundColor3 = col
						line.BackgroundTransparency = 1 - ESP.opacity

						-- имя / дистанция / здоровье
						local label = o.label
						local showText = (ESP.names or ESP.distance or ESP.health)
							and p2.X > 0 and p2.X < vp.X and p2.Y > 0 and p2.Y < vp.Y
						if showText then
							local parts = {}
							if ESP.names then table.insert(parts, plr.DisplayName) end
							if ESP.distance then table.insert(parts, "[" .. math.floor(dist) .. "]") end
							if ESP.health then table.insert(parts, math.floor(hum.Health) .. "hp") end
							label.Text = table.concat(parts, "  ")
							label.TextColor3 = col
							label.Position = UDim2.fromOffset(p2.X, p2.Y - 8)
						end
						label.Visible = showText
					end
				end
			end

			o.line.Visible = show
			if not show then o.label.Visible = false end
		end
	end
end

-- Chams: подсветка игроков сквозь стены (Highlight)
function Cham.update(t)
	if not Cham.enabled then
		if Cham.wasOn then
			Cham.wasOn = false
			for _, h in pairs(Cham.objects) do h.Enabled = false end
		end
		return
	end
	Cham.wasOn = true
	local idx = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			idx = idx + 1
			local h = Cham.objects[plr]
			if not h then
				h = Instance.new("Highlight")
				h.Name = "Cham"
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Parent = chamFolder
				Cham.objects[plr] = h
			end
			local char = plr.Character
			if char and isEnemy(plr, Cham.teamCheck) then
				local col = ESP.pickColor(ESP.color, plr, t, idx)
				h.Adornee = char
				h.FillColor = col
				h.OutlineColor = col:Lerp(Color3.new(1, 1, 1), 0.35)
				h.FillTransparency = Cham.fill
				h.OutlineTransparency = Cham.outline and 0 or 1
				h.Enabled = true
			else
				h.Enabled = false
			end
		end
	end
end

